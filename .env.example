FLASK_ENV=development
PORT=5000

# Optional MySQL settings. If these are empty, the API stores leads in backend/data/leads.jsonl.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=electropatios_automation

# Optional admin read token for GET /api/leads?token=...
ADMIN_TOKEN=change-me

# Safe GoHighLevel settings. Leave GHL_ENABLED=false while learning.
GHL_ENABLED=false
GHL_API_BASE=https://services.leadconnectorhq.com
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
GHL_STAGE_HIGH=
GHL_STAGE_MEDIUM=
GHL_STAGE_LOW=
GHL_ASSIGNED_USER_ID=
